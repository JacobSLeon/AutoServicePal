# ============================================================
# AutoServicePal — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ----- Application -----
NODE_ENV=development
PORT=3001

# ----- PostgreSQL -----
DATABASE_URL=postgresql://autoservicepal:yourpassword@localhost:5432/autoservicepal_db
# For test environment — uses a separate DB
TEST_DATABASE_URL=postgresql://autoservicepal:yourpassword@localhost:5432/autoservicepal_test

# ----- Redis -----
REDIS_URL=redis://localhost:6379

# ----- JWT -----
JWT_SECRET=change_this_to_a_long_random_secret_min_64_chars
JWT_EXPIRES_IN=7d

# ----- Email (SMTP) -----
# Works with SendGrid, Mailgun, Mailtrap, or any SMTP provider.
# For local dev, use Mailtrap: https://mailtrap.io
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_smtp_username
EMAIL_PASS=your_smtp_password
EMAIL_FROM="AutoServicePal <noreply@autoservicepal.com>"

# ----- DVLA API (Phase 2) -----
DVLA_API_KEY=your_dvla_api_key
DVLA_API_URL=https://driver-vehicle-licensing.api.gov.uk/vehicle-enquiry/v1/vehicles

# ----- Cloud Storage (Phase 2) -----
# AWS S3 or GCP Cloud Storage — configure one.
CLOUD_STORAGE_PROVIDER=s3
CLOUD_STORAGE_BUCKET=autoservicepal-uploads
CLOUD_STORAGE_REGION=eu-west-2
CLOUD_STORAGE_KEY_ID=your_access_key_id
CLOUD_STORAGE_SECRET=your_secret_access_key

# ----- Admin Seed -----
# Used by the database seed to create the initial admin account.
ADMIN_EMAIL=admin@autoservicepal.com
ADMIN_PASSWORD=AdminPass1!
ADMIN_FULL_NAME=AutoServicePal Admin
