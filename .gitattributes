# Normalise line endings for all text files to LF in the repo,
# while allowing Windows to use CRLF in working copies.
* text=auto eol=lf

# Force these to always be LF
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.env*  text eol=lf

# Binary files — do not modify
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
